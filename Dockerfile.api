# Root-context Dockerfile for the control plane (apps/api).
# Built by Railway's `railway up` upload (context = repo root), selected via the
# service's dockerfilePath=Dockerfile.api. Only apps/api is copied into the image.
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production

COPY apps/api/package.json apps/api/package-lock.json ./
RUN npm ci --omit=dev

COPY apps/api/ ./

EXPOSE 8787
CMD ["npm", "start"]
