# ── apps/api (Shipbot control plane) ──────────────────────────────────────────
# Required in production (the app refuses to boot without it when NODE_ENV=production):
SHIPBOT_WEBHOOK_SECRET=replace-with-a-strong-random-secret

# When set, the app uses Postgres (durable). Railway injects this automatically if
# you reference the Postgres service. If unset, it falls back to an in-memory store.
# DATABASE_URL=postgres://user:pass@host:5432/railway
# DATABASE_SSL=true            # set true for Railway's SSL Postgres over a public proxy

# Railway sets PORT automatically; local default is 8787.
# PORT=8787

# Public origin of the control plane (used in runner bootstrap). Railway provides
# RAILWAY_PUBLIC_DOMAIN automatically; override only if needed.
# SHIPBOT_CONTROL_URL=https://orbit-api.up.railway.app
