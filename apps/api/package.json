{
  "name": "shipbot-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "description": "Run-centric agent-delivery control plane (skeleton). Real correctness core; external services behind ports with in-memory stubs.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "pg": "8.13.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "typescript": "5.7.3"
  }
}
