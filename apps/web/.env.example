# ── apps/web (Orbit console) ──────────────────────────────────────────────────
# Origin of the deployed control plane (apps/api). NEXT_PUBLIC_* is inlined at
# BUILD time, so this must be set before `next build` runs (Railway passes service
# variables into the build). Leave empty to keep the UI running on the sim engine.
NEXT_PUBLIC_API_URL=https://orbit-api.up.railway.app
