  "scripts": {
    "newTask": [
      { "in": 1400, "to": "BUILDING", "kind": "pick", "runtime": "copilot", "note": "Picked up · cloning {repo} · planning the change" },
      { "in": 2400, "to": "BUILDING", "kind": "build", "note": "Edited the code and ran the tests" },
      { "in": 2400, "to": "REVIEWING", "setPr": true, "kind": "pr", "note": "Opened PR #{pr} · posted a walkthrough video",
        "evidence": [ { "id": "evn_v1", "type": "VIDEO", "url": "", "label": "walkthrough.mp4" }, { "id": "evn_d1", "type": "SCREENSHOT", "url": "", "label": "before / after" } ] },
      { "in": 2000, "checks": "success", "kind": "ci", "note": "CI green" },
      { "in": 1800, "verify": "start", "attempt": 1, "note": "Ran the app to check the result" },
      { "in": 2300, "verify": "fail", "attempt": 1, "to": "BUILDING", "note": "Result didn’t match — sending it back",
        "criteria": [ { "label": "Endpoint returns 200", "ok": true }, { "label": "X-RateLimit-* headers present", "ok": false } ],
        "evidence": [ { "id": "evn_s1", "type": "SCREENSHOT", "url": "", "label": "attempt 1" } ] },
      { "in": 2200, "kind": "refine", "note": "Fixed it — added the headers" },
      { "in": 1600, "verify": "start", "attempt": 2, "note": "Re-checking the result" },
      { "in": 2300, "verify": "pass", "attempt": 2, "to": "REVIEWING", "note": "Result matches what was asked",
        "criteria": [ { "label": "Endpoint returns 200", "ok": true }, { "label": "X-RateLimit-* headers present", "ok": true } ],
        "evidence": [ { "id": "evn_s2", "type": "SCREENSHOT", "url": "", "label": "attempt 2" }, { "id": "evn_v2", "type": "VIDEO", "url": "", "label": "verify.mp4" } ] },
      { "in": 2300, "to": "BUILDING", "kind": "review", "score": 3, "note": "Reviewer scored 3/5 — 2 comments" },
      { "in": 2100, "kind": "refine", "note": "Addressed the review" },
      { "in": 1700, "to": "REVIEWING", "kind": "build", "note": "Pushed fixes" },
      { "in": 2100, "kind": "review_ok", "score": 5, "note": "Reviewer scored 5/5 — approved" },
      { "in": 1500, "to": "AWAITING_HUMAN", "kind": "ready", "note": "Ready for approval" }
    ],
    "approve": [
      { "in": 700, "to": "MERGING", "note": "Merging…", "kind": "build" },
      { "in": 1900, "to": "DONE", "note": "Merged ✔ · closes this task", "kind": "merged" }
    ],
    "requestChanges": [
      { "in": 300, "to": "BUILDING", "note": "You requested changes — the agent is addressing them", "kind": "review" },
      { "in": 3200, "to": "REVIEWING", "note": "Pushed fixes", "kind": "build" },
      { "in": 2600, "to": "AWAITING_HUMAN", "review": "approved", "note": "Ready for approval", "kind": "ready" }
    ],
    "continueBlocked": [
      { "in": 1400, "to": "BUILDING", "checks": "pending", "note": "Resuming with your hint", "kind": "build" },
      { "in": 3500, "to": "REVIEWING", "checks": "success", "note": "CI green · sibling test fixed", "kind": "ci" },
      { "in": 2600, "to": "AWAITING_HUMAN", "review": "approved", "note": "Ready for approval", "kind": "ready" }
    ],
    "abort": [
      { "in": 300, "to": "CANCELLED", "note": "Aborted · branch & PR are kept", "kind": "abort" }
    ]
  }
